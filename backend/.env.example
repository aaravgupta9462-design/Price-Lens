# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pricelens?schema=public

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (For future authentication step)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GOOGLE_CALLBACK_URL=http://localhost:5000/v1/auth/google/callback

# Allowed Frontend Client Origin
FRONTEND_URL=http://localhost:5173
