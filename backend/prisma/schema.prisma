// Prisma Schema Configuration for PriceLens Backend Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  fullName     String
  email        String?      @unique
  mobile       String?      @unique
  passwordHash String?
  googleId     String?      @unique
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  priceAlerts  PriceAlert[]

  @@index([email])
  @@index([mobile])
  @@map("users")
}

model Product {
  id                 String              @id
  name               String
  brand              String?
  category           String?
  emoji              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  priceHistories     PriceHistory[]
  priceAlerts        PriceAlert[]
  reviewIntelligence ReviewIntelligence?

  @@map("products")
}

model PriceHistory {
  id         String   @id @default(uuid())
  productId  String
  store      String
  price      Float
  currency   String   @default("INR")
  recordedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([store])
  @@index([recordedAt])
  @@index([productId, store, recordedAt])
  @@map("price_histories")
}

model PriceAlert {
  id            String    @id @default(uuid())
  userId        String
  productId     String
  store         String?
  targetPrice   Decimal   @db.Decimal(10, 2)
  initialPrice  Decimal   @db.Decimal(10, 2)
  currentPrice  Decimal?  @db.Decimal(10, 2)
  isActive      Boolean   @default(true)
  isTriggered   Boolean   @default(false)
  triggeredAt   DateTime?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@index([productId, isActive])
  @@map("price_alerts")
}

model ReviewIntelligence {
  id                    String   @id @default(uuid())
  productId             String   @unique
  trustScore            Decimal  @db.Decimal(4, 2)
  reliabilityTag        String
  authenticityBreakdown Json
  sentimentDistribution Json
  positivePoints        Json
  complaintPoints       Json
  sampleReviews         Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("review_intelligence")
}
