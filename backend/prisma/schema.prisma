// Prisma Schema Configuration for PriceLens Backend Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String?  @unique
  mobile       String?  @unique
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([mobile])
  @@map("users")
}

model Product {
  id             String         @id
  name           String
  brand          String?
  category       String?
  emoji          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  priceHistories PriceHistory[]

  @@map("products")
}

model PriceHistory {
  id         String   @id @default(uuid())
  productId  String
  store      String
  price      Float
  currency   String   @default("INR")
  recordedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([store])
  @@index([recordedAt])
  @@index([productId, store, recordedAt])
  @@map("price_histories")
}
